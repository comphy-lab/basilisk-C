-    if (H > dry) {
-      double c = um/CFL + sqrt(G*(hydrostatic ? H : Delta*tanh(H/Delta)))/CFL_H;
-      if (c > 0.) {
-	double dt = min(cm[], cm[-1])*Delta/(c*fm.x[]);
-	if (dt < dtmax)
