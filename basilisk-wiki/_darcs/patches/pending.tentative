-ax = axes.ravel()
-ax[0].semilogy(t, residual_p)
-ax[1].semilogy(t, residual_u)
-ax[0].set_xlabel('Time')
-ax[0].set_ylabel('Residual pressure')
-ax[1].set_xlabel('Time')
-ax[1].set_ylabel('Residual velocity')
