-#if HAVE_CJSON
-/**
-Parse domain parameters from JSON object
-*/
-void parse_domain_section(cJSON *domain, SimParams *p) {
-    if (!domain) return;
-    
-    GET_DOUBLE(domain, width, p->width);
-    GET_DOUBLE(domain, height, p->height);
-    GET_DOUBLE(domain, depth, p->depth);
