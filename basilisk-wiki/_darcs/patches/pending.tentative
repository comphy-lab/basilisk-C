-    double cfl;             // CFL number
-    double dt;              // Time step
-    double tolerance;       // Solver tolerance
-    int nitermin;           // Minimum iterations
-    
-    /** Runtime parameters */
-    double walltime;        // Maximum wall time (seconds)
-    double endtime;         // Simulation end time
-} SimParams;
-
