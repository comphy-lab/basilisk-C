-            coord ns = {-ct, st};
-
-            double dot = -(nf.x*ns.x + nf.y*ns.y);
-            dot = clamp(dot, -1., 1.);
-
-            d.theta_left = acos(dot)*180./pi;
-        }
-    }
-    return d;
-}
