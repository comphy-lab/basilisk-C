-    double min_dim = p->depth;
-    p->aspectratio_x = p->width / min_dim;
-    p->aspectratio_y = p->depth / min_dim;
-    p->aspectratio_z = p->height / min_dim;
-#endif
-}
-
-/**
-Parse dimensionless parameters from JSON object
