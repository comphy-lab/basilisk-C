@@ -69,6 +69,9 @@
 # define DISPLAY_JS "http://basilisk.ida.upmc.fr/three.js/editor/index.html"
 #endif
 
+// Runtime override for the JavaScript client base URL
+static const char *display_js_base = NULL;
+
 #ifndef DISPLAY_HOST
 # define DISPLAY_HOST "localhost"
 #endif
@@ -702,8 +705,28 @@
