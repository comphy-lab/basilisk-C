+  const char * js_base = display_js_base ? display_js_base : DISPLAY_JS;
+  fprintf (fp, "%s?ws://%s:%d", js_base, h ? h->h_name : "127.0.0.1",
 	   Display.port);
+}
+
+/**
+ * Set a custom JavaScript client base URL at runtime.
+ * This overrides the default DISPLAY_JS macro value.
+ * Also rewrites display.html if the display system is already initialized.
+ */
+void display_set_js_base (const char * base)
+{
+  display_js_base = base;
+  if (pid() == 0 && Display.port > 0) {
+    FILE * fp = fopen ("display.html", "w");
+    if (fp) {
+      fputs ("<head><meta http-equiv=\"refresh\" content=\"0;URL=", fp);
+      display_url (fp);
+      fputs ("\"></head>\n", fp);
+      fclose (fp);
+    }
+  }
 }
 
 int display_usage = 20; // use 20% of runtime, maximum
