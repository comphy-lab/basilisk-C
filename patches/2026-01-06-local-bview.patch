 #define DISPLAY_NO_CONTROLS
 #include "display.h"
 
+/**
+ * Print usage information and exit.
+ */
+static void usage (const char * progname)
+{
+  fprintf (stderr,
+	   "Usage: %s [OPTIONS] [DUMP_FILE]\n\n"
+	   "Options:\n"
+	   "  -d, -debug       Enable debug output\n"
+	   "  --local          Use localhost:8000 for the JavaScript client\n"
+	   "  --local=PORT     Use localhost:PORT (PORT must be 1-65535)\n\n"
+	   "If DUMP_FILE is not specified, defaults to 'dump'.\n",
+	   progname);
+  exit (1);
+}
+
+/**
+ * Parse --local or --local=PORT argument.
+ * Returns the port number (default 8000) or -1 if invalid.
+ */
+static int parse_local_arg (const char * arg)
+{
+  if (!strcmp (arg, "--local"))
+    return 8000;
+  if (strncmp (arg, "--local=", 8) == 0) {
+    char * endptr;
+    long port = strtol (arg + 8, &endptr, 10);
+    if (*endptr != '\0' || port < 1 || port > 65535)
+      return -1;
+    return (int) port;
+  }
+  return 0;
+}
+
 int main (int argc, char * argv[])
 {
-  char * file = "dump"; argc--; argv++;
+  char * file = "dump";
+  int local_port = 0;
