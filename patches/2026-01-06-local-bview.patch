   for (char * arg = *argv; argc; argc--, arg = *++argv) {
     if (!strcmp (arg, "-debug") || !strcmp (arg, "-d"))
       Display.debug = true;
+    else if (strncmp (arg, "--local", 7) == 0) {
+      int port = parse_local_arg (arg);
+      if (port < 0) {
+        fprintf (stderr, "%s: invalid port in '%s'\n", progname, arg);
+        usage (progname);
+      }
+      if (port > 0)
+        local_port = port;
+    }
