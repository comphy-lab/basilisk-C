BEGIN {
    RS = ";";
    FS = ",";
    types[0] = "pstring";
    types[1] = "pint";
    types[2] = "punsigned";
    types[3] = "pbool";
    types[4] = "pfloat";
    types[5] = "pdouble";
    types[6] = "pdouble";
    types[7] = "pcolormap";

    format[0] = "%s";  zero[0] = "\"\"";
    format[1] = "%d";  zero[1] = "0";
    format[2] = "%d";  zero[2] = "0";
    format[3] = "%d";  zero[3] = "0";
    format[4] = "%f";  zero[4] = "0.";
    format[5] = "%lf"; zero[5] = "0.";
    format[6] = "%lf"; zero[6] = "0.";
    format[7] = "%f";  zero[7] = "0.";

    ORS = ""

    draw_ui = "draw_ui.h"
    
    print "// Automatically generated by params.awk\n"
    print "// Automatically generated by params.awk\n" > "draw_json.h"
    print "/**\n# Automatically generated by [params.awk]() */\n" > draw_ui
#    print "#include \"parse.h\""
}

function print1(f, args)
{
    gsub("[\"]", "\\\"", f)
    print "  i = snprintf (s, len, \"" f "\"" >> "draw_json.h"
    if (args != "")
	print ", " args  >> "draw_json.h";
    print ");\n" >> "draw_json.h"
    print "  s += i, len -= i, len1 += i;\n" >> "draw_json.h"
}

function gettype(c)
{
    if (c[2] == "*") {
	if (c[1] == "char")
	    return 0;
    }
    else if (c[1] == "int")
	return 1;
    else if (c[1] == "unsigned")
	return 2;
    else if (c[1] == "bool")
	return 3;
    else if (c[1] == "float")
	return 4;
    else if (c[1] == "double")
	return 5;
    else if (c[1] == "coord")
	return 6;
    else if (c[1] == "colormap" || c[1] == "Colormap")
	return 7;
    return -1;
}

function ui(name, b, n,     c, d)
{
    print "\n/**\n## " name "() */\n" >> draw_ui
    print "\ntypedef struct {\n" >> draw_ui
    print "  UIDrawItem ui;\n" >> draw_ui
    defaults = ""
    for (i = 1; i <= n; i++) if (!match (b[i], "/[*]ui-hidden[*]/")) {
        split (b[i], c, "[ \t]*=[ \t]*");
        if (split (c[1], d, "[ \t\n[]+") > 1 && gettype(d) >= 0) {
            if (d[1] == "char" && d[2] == "*") {
                print "  char " d[3] "[80];\n" >> draw_ui;
                vname = d[3];
                if (!c[2] || c[2] == "NULL")
                    def = "\"\"";
                else
                    def = c[2];
            }
            else {
                vname = d[2];
                if (d[1] == "unsigned")
                    print "  int " vname ";\n" >> draw_ui;
                else
                    print "  " c[1] ";\n" >> draw_ui;
                if (c[2])
                    def = c[2];
                else
                    def = "";
            }
            if (def != "") {
                if (defaults != "")
                    defaults = defaults ",\n";
                defaults = defaults "  ." vname " = " def;
            }
        }
        else
            print "  // " c[1] ";\n" >> draw_ui;
    }
    print "} ui_" name ";\n" >> draw_ui;
    print "\n" >> draw_ui;
    print "ui_" name " ui_" name "_defaults = {\n" >> draw_ui;
    print defaults >> draw_ui;
    print "\n};\n" >> draw_ui;

    print "\nstatic bool " name "_properties (UIDrawItem *item)\n" >> draw_ui
    print "{\n"  >> draw_ui
    print "  bool changed = false;\n" >> draw_ui
    print "  ui_" name " *ui = (ui_" name " *) item;\n" >> draw_ui
    for (i = 1; i <= n; i++) if (!match (b[i], "/[*]ui-hidden[*]/")) {
        split (b[i], c, "[ \t]*=[ \t]*");
        split (c[1], d, "[ \t\n[]+");
        vname = d[2] == "*" ? d[3] : d[2];
        if (vname == "expr") continue;
        array = d[2] != "*" && d[3];
        if (d[1] == "char" && d[2] == "*")
            print "  IgInputText (\"" vname "\", ui->" vname ", sizeof(ui->" vname "), 0);\n" >> draw_ui
        else if (d[1] == "Colormap") {
            print "  if (IgComboChar (\"" vname "\", &ui->" vname ", colormaps, ncolormaps))\n" >> draw_ui
            print "    changed = true;\n" >> draw_ui
        }
        else if (d[1] == "int" || d[1] == "unsigned")
            print "  IgInputInt (\"" vname "\", &ui->" vname ");\n" >> draw_ui
        else if (d[1] == "double" && !array)
            print "  IgInputDouble (\"" vname "\", &ui->" vname ");\n" >> draw_ui
        else if (d[1] == "float") {
            if (d[3] == "3]") {
                print "  if (IgColorEdit3 (\"" vname "\", ui->" vname ", 0))\n" >> draw_ui
                print "    changed = true;\n" >> draw_ui
            }
            else if (!array)
                print "  IgInputFloat (\"" vname "\", &ui->" vname ");\n" >> draw_ui
        }
        else if (d[1] == "bool") {
            print "  if (IgCheckbox (\"" vname "\", &ui->" vname "))\n" >> draw_ui
            print "    changed = true;\n" >> draw_ui
        }
        else if (d[1] == "coord")
            print "  IgInputScalarN (\"" vname "\", ImGuiDataType_Double, &ui->" vname ".x, 3);\n" >> draw_ui
        else
            continue;
        if (d[1] != "bool" && d[1] != "Colormap" && !array) {
            print "  if (IgIsItemDeactivatedAfterEdit())\n" >> draw_ui
            print "    changed = true;\n" >> draw_ui
        }
    }
    print "  return changed;\n" >> draw_ui
    print "}\n"  >> draw_ui

    print "\nstatic char *" name "_command (UIDrawItem *item)\n" >> draw_ui
    print "{\n" >> draw_ui
    print "  ui_" name " *ui = (ui_" name " *)item;\n" >> draw_ui
    print "  char *command = strdup (\"" name, "(\"), * sep = \"\";\n" >> draw_ui

    for (i = 1; i <= n; i++) if (!match (b[i], "/[*]ui-hidden[*]/")) {
        split (b[i], c, "[ \t]*=[ \t]*");
        split (c[1], d, "[ \t\n[]+");
        vname = d[2] == "*" ? d[3] : d[2];
        if (vname == "expr") continue;
        type = "";
        if (d[1] == "char" && d[2] == "*")
            type = "\\\"%s\\\"";
        else if (d[1] == "int" || d[1] == "bool" || d[1] == "unsigned")
            type = "%d";
        else if (d[1] == "float")
            type = "%g";
        else if (d[1] == "double")
            type = "%g";
        else if (d[1] == "coord")
            type = "%g";
        else if (d[1] == "Colormap")
            type = "%s";
        if (type != "") {
            if (type == "\\\"%s\\\"")
                print "  if (strcmp (ui->" vname ", ui_" name "_defaults." vname ")) {\n" >> draw_ui;
            else if (d[3])
                print "  if (memcmp (ui->" vname ", ui_" name "_defaults." vname ", "int(d[3])"*sizeof *ui->"vname")) {\n" >> draw_ui;
            else if (d[1] == "coord")
                print "  if (memcmp (&ui->" vname ", &ui_" name "_defaults." vname ", sizeof ui->"vname")) {\n" >> draw_ui;
            else
                print "  if (ui->" vname " != ui_" name "_defaults." vname ") {\n" >> draw_ui;
            
            print "    char *s;\n" >> draw_ui;
            if (d[1] == "Colormap")
                print "    if (asprintf (&s, \"%s" vname " = " type "\", sep, colormaps[ui->" vname "]) < 0) return NULL;\n" >> draw_ui;
            else if (d[2] != "*" && d[3]) {
                print "    if (asprintf (&s, \"%s" vname " = {" >> draw_ui;
                print type >> draw_ui;
                for (j = 1; j < int(d[3]); j++)
                    print "," type >> draw_ui;
                print "}\", sep, ui->"vname"[0]" >> draw_ui;
                for (j = 1; j < int(d[3]); j++)
                    print ", ui->"vname"["j"]" >> draw_ui;
                print ") < 0) return NULL;\n" >> draw_ui;
            }
            else if (d[1] == "coord") {
                print "    if (asprintf (&s, \"%s" vname " = {" >> draw_ui;
                print type >> draw_ui;
                for (j = 1; j < 3; j++)
                    print "," type >> draw_ui;
                print "}\", sep, ui->"vname".x" >> draw_ui;
                print ", ui->"vname".y" >> draw_ui;
                print ", ui->"vname".z" >> draw_ui;
                print ") < 0) return NULL;\n" >> draw_ui;
            }
            else
                print "    if (asprintf (&s, \"%s" vname " = " type "\", sep, ui->" vname ") < 0) return NULL;\n" >> draw_ui;
            print "    command = realloc (command, strlen (command) + strlen (s) + 1);\n" >> draw_ui;
            print "    strcat (command, s); free (s); sep = \", \";\n" >> draw_ui;
            print "  }\n" >> draw_ui;
        }
    }

    print "  command = realloc (command, strlen (command) + 3); strcat (command, \");\");\n" >> draw_ui;
    print "  return command;\n" >> draw_ui
    print "}\n" >> draw_ui
    
    print "\nstatic const char *" name "_summary (UIDrawItem *item)\n" >> draw_ui
    print "{\n" >> draw_ui

    split (b[1], c, "[ \t]*=[ \t]*");
    split (c[1], d, "[ \t\n[]+");
    if (d[1] == "char" && d[2] == "*")
        print "  return ((ui_" name " *)item)->" d[3] ";\n" >> draw_ui;
    else
        print "  return NULL;\n" >> draw_ui
    print "}\n" >> draw_ui
    print "\n" >> draw_ui
    
    print "UIDrawItem *ui_" name "_new()\n" >> draw_ui
    print "{\n" >> draw_ui
    print "  ui_" name " *ui = calloc (1, sizeof(ui_" name "));\n" >> draw_ui
    print "  *ui = ui_" name "_defaults;\n" >> draw_ui
    print "  ui->ui.name = \"" name "\";\n" >> draw_ui
    print "  ui->ui.visible = true;\n" >> draw_ui
    print "  ui->ui.properties = " name "_properties;\n" >> draw_ui
    print "  ui->ui.summary = " name "_summary;\n" >> draw_ui
    print "  ui->ui.command = " name "_command;\n" >> draw_ui
    for (i = 1; i <= n; i++) {
        split (b[i], c, "[ \t]*=[ \t]*");
        split (c[1], d, "[ \t\n[]+");
    }
    print "  return &ui->ui;\n" >> draw_ui
    print "}\n" >> draw_ui

    print "\nstatic UIDrawItem * " name " (\n" >> draw_ui
    for (i = 1; i <= n; i++) {
        split (b[i], c, "[ \t]*=[ \t]*");
        split (c[1], d, "[ \t\n[]+");
        vname = d[2] == "*" ? d[3] : d[2];
        if (vname)
            print (i > 1 ? ",\n  " : "  ") c[1] >> draw_ui;
    }
    print "\n)\n{\n" >> draw_ui
    print "  UIDrawItem *item = ui_" name "_new();\n" >> draw_ui
    print "  ui_" name " *ui = (ui_" name " *)item;\n" >> draw_ui
    for (i = 1; i <= n; i++) if (!match (b[i], "/[*]ui-hidden[*]/")) {
        split (b[i], c, "[ \t]*=[ \t]*");
        split (c[1], d, "[ \t\n[]+");
        vname = d[2] == "*" ? d[3] : d[2];
        if (vname && d[1] != "MapFunc" && d[1] != "bview") {
            if (d[1] == "char" && d[2] == "*") # string
                print "  if (" vname ") strncpy (ui->" vname ", " vname ", 79);\n" >> draw_ui;
            else if (d[2] != "*" && d[3]) # array
                print "  memcpy (ui->" vname ", " vname ", "int(d[3])"*sizeof *" vname ");\n" >> draw_ui;
            else
                print "  ui->" vname " = " vname ";\n" >> draw_ui;
        }
    }
    print "  return item;\n" >> draw_ui
    print "}\n" >> draw_ui
}
    
/\([^)]*\)[\t\n ]*{/ {
    if (match($0, /([a-zA-Z_]+)[\t\n ]+([a-zA-Z_]+)[\t\n ]+([a-zA-Z_0-9]+)[\t\n ]*\(([^)]*)\)[\t\n ]*{/, a) &&
	a[1] == "static")
	;
    else if (match($0, /([a-zA-Z_]+)[\t\n ]+([a-zA-Z_0-9]+)[\t\n ]*\(([^)]*)\)[\t\n ]*{/, a) &&
	     a[1] != "else" && a[3] != "" && !match(a[3], /struct[ \t]+/) &&
             (a[1] == "void" || a[1] == "bool") &&
             a[2] != "colorbar") {
	rettype = a[1];
	name = a[2];
	params = a[3];
	print "else if (!strcmp (s, \"" name "\")) {\n"
	print "int _" name "_json (char * s, int len) {\n" >> "draw_json.h"
        print "  int i, len1 = 0;\n" >> "draw_json.h"
	print1("  \"" name "\" : {", "");
        nc = "\\n"
	n = split (params, b, ",[ \t\n]");
	for (i = 1; i <= n; i++) {
	    gsub(/^[ \t\n]+/, "", b[i]);
	    gsub(/[ \t\n]+$/, "", b[i])
            if (b[i] != "COLORBAR_PARAMS") {
                print "  " b[i];
                if (!match(b[i], /=/)) {
                    split (b[i], c, "[ \n\t]+");
                    type = gettype(c);
                    if (type == 0)
                        print " = NULL";
                    else if (type > 0)
                        print " = " zero[type];
                }
                print ";\n";
            }
	}

        ui(name, b, n);
        
	print "  Params params[] = {\n"
	for (i = 1; i <= n; i++) {
	    nf = split (b[i], c, "[ \n\t]+");
	    type = gettype(c);
	    pos = c[2] == "*" ? 3 : 2;
	    param[i] = c[pos];
	    gsub ("\\[.*\\]", "", param[i])
	    if (type >= 0) {
		d = "";
		for (j = pos; j <= nf && c[j] != "="; j++)
		    d = d c[j];
		split (d, e, ",|;");
		for (j in e) {
		    if (e[j] != "" && e[j] != "expr" && substr (e[j],1,1) != "/") {
			if (gsub ("[\\[\\]]", " ", e[j])) {
			    split (e[j], f, " ");
			    print "    {\"" f[1] "\", " types[type] ", " f[1] ", " f[2] "},\n";
			    tname = f[1] == "fc" || f[1] == "lc" ? "color" : types[type];
			    s = nc "    \"" f[1] "\": { \"type\": \"" tname \
				"\", \"cardinality\": " f[2] ", \"value\": [" format[type];
			    for (k = 1; k < f[2]; k++)
				s = s "," format[type];
			    s = s "] }";
			    s1 = zero[type]; # f[1] "[0]";
			    for (k = 1; k < f[2]; k++)
				s1 = s1 ", " zero[type]; # f[1] "[" k "]";
			    print1(s, s1);
			}
			else if (type == 6) {
			    print "    {\"" e[j] "\", " types[type] ", &" e[j] ", 3},\n";
			    print1(nc "    \"" e[j] "\": { \"type\": \"" types[type] \
				   "\", \"cardinality\": 3, \"value\": [%lf,%lf,%lf] }",
				   zero[type] ", " zero[type] ", " zero[type]);
				   # e[j] ".x, " e[j] ".y, " e[j] ".z");
			}
			else {
			    print "    {\"" e[j] "\", " types[type] ", &" e[j] "},\n";
			    if (type != 7) # colormap: fixme: does nothing for the moment
				print1(nc "    \"" e[j] "\": { \"type\": \"" types[type] \
				       "\", \"cardinality\": 1, \"value\": \"" format[type] "\" }", zero[type]); # e[j]);
			}
			nc = ",\\n";
		    }
                    
                }
	    }
	}
	print "    {NULL}\n  };\n"
	print "  if (!parse_params (params))\n"
        print "    return false;\n"
	printf "  ";
	if (rettype == "bool")
	    printf "return ";
        printf name " (";
        for (i = 1; i <= n; i++) {
            printf param[i];
            if (i < n && param[i+1] != "")
                printf (",");
        }
        print ");\n"
        print "}\n"
	print1("\\n  }");
        print "  return len1;\n" >> "draw_json.h"
        print "}\n" >> "draw_json.h"
    }
}
